# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Canonical site origin for auth emails (set on Vercel to the production URL,
# e.g. https://forpeopletorememebr.vercel.app). Also update Supabase dashboard:
# Authentication > URL Configuration > Site URL + Redirect URLs.
NEXT_PUBLIC_SITE_URL=

# --- Optional: "Auto-fill with AI" enrichment (server-only, never exposed) ---
# Free Gemini key from https://aistudio.google.com/apikey
# Without it, enrichment still works using GitHub facts only.
GEMINI_API_KEY=

# Optional: raises the GitHub API rate limit (public, read-only is enough).
# Without it, unauthenticated GitHub lookups still work for personal use.
GITHUB_TOKEN=

# --- Optional: Scrapling scraper sidecar (deep profile scraping) ---
# Local dev:   cd scraper && ./run.sh  →  SCRAPER_URL=http://127.0.0.1:8787
# Production:  deploy scraper/ (Dockerfile included) to Railway/Fly/Render,
#              then point SCRAPER_URL at its public URL.
# SCRAPER_TOKEN: shared secret — set the SAME value on the scraper service
# and here. Required in production so strangers can't use your scraper.
SCRAPER_URL=
SCRAPER_TOKEN=
